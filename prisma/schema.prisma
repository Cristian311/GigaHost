// GigaHost data model.
//
// Runs on MySQL / MariaDB (the XAMPP instance in development). Free-text and
// JSON columns are declared @db.Text because MySQL strings default to
// VARCHAR(191); @db.Text also maps cleanly to PostgreSQL `text`, so switching
// to `provider = "postgresql"` stays a one-line change followed by a fresh
// `prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ServerStatus {
  PENDING
  INSTALLING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  SUSPENDED
  ERROR
  DELETED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum OrderKind {
  NEW
  RESIZE
  RENEWAL
}

enum CouponKind {
  /// `value` is a percentage (1-100).
  PERCENT
  /// `value` is an amount in cents.
  FIXED
}

/// Why a server is SUSPENDED. Billing suspensions lift automatically once the
/// outstanding invoice is paid; admin suspensions never do.
enum SuspensionReason {
  BILLING
  ADMIN
}

enum BackupStatus {
  CREATING
  COMPLETED
  RESTORING
  FAILED
}

enum ServerEventType {
  CREATED
  INSTALLED
  STARTED
  STOPPED
  RESTARTED
  RESIZED
  BACKUP_CREATED
  BACKUP_RESTORED
  BACKUP_DELETED
  SUSPENDED
  UNSUSPENDED
  RENEWED
  PAYMENT_FAILED
  DELETED
  ERROR
}

// ---------------------------------------------------------------------------
// Users & Auth.js
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  passwordHash  String?
  role          Role      @default(USER)
  locale        String    @default("en")
  /// Customer object at the payment gateway; created on first checkout.
  stripeCustomerId String? @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  servers       Server[]
  orders        Order[]
  subscriptions Subscription[]
  invoices      Invoice[]
  couponRedemptions CouponRedemption[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog: games, regions, pricing
// ---------------------------------------------------------------------------

model Game {
  id                String  @id @default(cuid())
  slug              String  @unique
  name              String
  /// Short tagline shown on cards.
  tagline           String
  /// Longer description shown on the game detail page.
  description       String  @db.Text
  /// Path under /public (e.g. /games/minecraft.svg) or an absolute URL.
  image             String
  /// Accent colour used for gradients on cards (hex).
  accentColor       String  @default("#7c3aed")
  minRamGb          Int
  recommendedRamGb  Int
  minCpu            Int     @default(1)
  minStorageGb      Int     @default(10)
  /// JSON-encoded string[] of supported versions.
  versions          String  @default("[]") @db.VarChar(1024)
  available         Boolean @default(true)
  unavailableReason String? @db.Text
  sortOrder         Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers Server[]
}

model Region {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  country         String
  /// Emoji flag, e.g. 🇷🇴
  flag            String
  /// Multiplies the monthly price (1.0 = base).
  priceMultiplier Float   @default(1.0)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  servers Server[]
}

/// Prices are stored as integer cents to avoid floating point money.
model PricingConfig {
  id                    String   @id @default(cuid())
  name                  String   @default("default")
  active                Boolean  @default(true)
  currency              String   @default("EUR")
  basePriceCents        Int
  pricePerGbRamCents    Int
  pricePerVcpuCents     Int
  pricePerGbStorageCents Int
  /// 0.05 = 5 % off when paying quarterly
  quarterlyDiscount     Float    @default(0.05)
  /// 0.15 = 15 % off when paying yearly
  yearlyDiscount        Float    @default(0.15)
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Servers
// ---------------------------------------------------------------------------

model Server {
  id              String       @id @default(cuid())
  name            String
  ownerId         String
  gameId          String
  regionId        String
  ramGb           Int
  vcpu            Int
  storageGb       Int
  gameVersion     String?
  status          ServerStatus @default(PENDING)
  /// Used by the mock provider to compute lazy state transitions.
  statusChangedAt DateTime     @default(now())
  /// Set only while status is SUSPENDED.
  suspensionReason SuspensionReason?
  /// Identifier on the provisioning backend (mock id / Pterodactyl uuid).
  providerId      String?      @unique
  ip              String?
  port            Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id])
  region       Region        @relation(fields: [regionId], references: [id])
  subscription Subscription?
  orders       Order[]
  backups      Backup[]
  events       ServerEvent[]

  @@index([ownerId])
}

/// Simulated (Phase 1) or real (Phase 2) server backups.
model Backup {
  id                String       @id @default(cuid())
  serverId          String
  name              String
  sizeMb            Int          @default(0)
  status            BackupStatus @default(CREATING)
  /// Identifier on the provisioning backend.
  providerBackupId  String?
  statusChangedAt   DateTime     @default(now())
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Activity log shown on the server page.
model ServerEvent {
  id        String          @id @default(cuid())
  serverId  String
  type      ServerEventType
  message   String?         @db.Text
  /// JSON payload with extra details (e.g. old/new resources).
  meta      String?         @db.Text
  createdAt DateTime        @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Order {
  id             String        @id @default(cuid())
  userId         String
  serverId       String?
  kind           OrderKind     @default(NEW)
  status         OrderStatus   @default(PENDING)
  billingPeriod  BillingPeriod
  /// JSON snapshot of the configuration at order time.
  configSnapshot String        @db.Text
  subtotalCents  Int
  /// Billing-period discount (quarterly / yearly).
  discountCents  Int
  /// Discount from a coupon; first order only, never applied to renewals.
  couponDiscountCents Int      @default(0)
  /// Downgrade credit consumed by this order (renewals only).
  creditAppliedCents  Int      @default(0)
  /// subtotal - discount - couponDiscount - creditApplied
  totalCents     Int
  currency       String        @default("EUR")
  /// "mock" | "stripe"; null for orders that needed no payment.
  paymentProvider  String?
  /// Gateway id of the payment (Checkout Session or PaymentIntent).
  paymentReference String?     @unique
  couponId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  server       Server?           @relation(fields: [serverId], references: [id], onDelete: SetNull)
  coupon       Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  subscription Subscription?
  redemption   CouponRedemption?

  @@index([userId])
  @@index([serverId, kind, status])
}

model Coupon {
  id             String     @id @default(cuid())
  /// Stored upper-case; lookups are case-insensitive.
  code           String     @unique
  kind           CouponKind
  /// Percentage (1-100) or cents, depending on `kind`.
  value          Int
  /// null = unlimited
  maxRedemptions Int?
  timesRedeemed  Int        @default(0)
  perUserLimit   Int        @default(1)
  /// Order total (after the period discount) required to use the coupon.
  minOrderCents  Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  userId      String
  orderId     String   @unique
  amountCents Int
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  serverId           String             @unique
  orderId            String             @unique
  status             SubscriptionStatus @default(ACTIVE)
  billingPeriod      BillingPeriod
  amountCents        Int
  /// Credit accumulated from downgrades, applied at the next renewal.
  creditCents        Int                @default(0)
  currency           String             @default("EUR")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// When the first renewal charge failed; drives suspension and deletion.
  pastDueSince       DateTime?
  lastChargeAttemptAt DateTime?
  chargeAttempts     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

model Invoice {
  id          String        @id @default(cuid())
  /// Human readable number, e.g. GH-2026-000123
  number      String        @unique
  userId      String
  orderId     String
  status      InvoiceStatus @default(OPEN)
  amountCents Int
  currency    String        @default("EUR")
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  paidAt      DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
}

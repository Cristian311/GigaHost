// GigaHost data model.
//
// Runs on MySQL / MariaDB (the XAMPP instance in development). Free-text and
// JSON columns are declared @db.Text because MySQL strings default to
// VARCHAR(191); @db.Text also maps cleanly to PostgreSQL `text`, so switching
// to `provider = "postgresql"` stays a one-line change followed by a fresh
// `prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ServerStatus {
  PENDING
  INSTALLING
  STOPPED
  STARTING
  RUNNING
  STOPPING
  SUSPENDED
  ERROR
  DELETED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  /// Money given back, in full or in part. Kept distinct from CANCELLED,
  /// which means it was never paid.
  REFUNDED
  /// The cardholder disputed the charge with their bank.
  DISPUTED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum OrderKind {
  NEW
  RESIZE
  RENEWAL
}

enum CouponKind {
  /// `value` is a percentage (1-100).
  PERCENT
  /// `value` is an amount in cents.
  FIXED
}

/// Why a server is SUSPENDED. Billing suspensions lift automatically once the
/// outstanding invoice is paid; admin suspensions never do.
enum SuspensionReason {
  BILLING
  ADMIN
}

enum BackupStatus {
  CREATING
  COMPLETED
  RESTORING
  FAILED
}

enum ServerEventType {
  CREATED
  INSTALLED
  STARTED
  STOPPED
  RESTARTED
  RESIZED
  BACKUP_CREATED
  BACKUP_RESTORED
  BACKUP_DELETED
  SUSPENDED
  UNSUSPENDED
  RENEWED
  PAYMENT_FAILED
  REFUNDED
  DISPUTED
  ADDON_INSTALLED
  ADDON_REMOVED
  TASK_RAN
  DELETED
  ERROR
}

enum ConsoleEntryKind {
  COMMAND
  OUTPUT
}

enum TaskAction {
  RESTART
  BACKUP
  COMMAND
}

enum TaskFrequency {
  HOURLY
  DAILY
  WEEKLY
}

enum AddonKind {
  PLUGIN
  MOD
  MODPACK
}

// ---------------------------------------------------------------------------
// Users & Auth.js
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?   @db.Text
  passwordHash  String?
  role          Role      @default(USER)
  locale        String    @default("en")
  /// Customer object at the payment gateway; created on first checkout.
  stripeCustomerId String? @unique
  /// Bumped on password change or reset; sessions issued for an older value
  /// stop being accepted.
  sessionVersion Int       @default(0)
  /// Last support heartbeat (admins only); drives the live chat "online" dot.
  lastSeenAt    DateTime?
  /// When the terms were accepted, and which version. Null for accounts that
  /// pre-date the checkbox; recording only a boolean would not say what was
  /// agreed to.
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  servers             Server[]
  orders              Order[]
  subscriptions       Subscription[]
  invoices            Invoice[]
  couponRedemptions   CouponRedemption[]
  passwordResetTokens PasswordResetToken[]
  emails              EmailMessage[]
  auditLogs           AuditLog[]
  tickets             Ticket[]             @relation("TicketUser")
  assignedTickets     Ticket[]             @relation("TicketAssignee")
  ticketMessages      TicketMessage[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Single-use, short-lived. Only a hash is stored, so a database leak does not
/// hand out working reset links.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailStatus {
  /// No SMTP configured: kept in the outbox only (development).
  LOGGED
  SENT
  FAILED
}

/// Outbox: every email the app produces, delivered or not.
model EmailMessage {
  id        String      @id @default(cuid())
  userId    String?
  to        String
  subject   String
  template  String
  text      String      @db.Text
  html      String      @db.Text
  status    EmailStatus
  error     String?     @db.Text
  /// Delivery attempts made so far; the retry job gives up after a few.
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([to])
  @@index([status])
}

/// Fixed-window counters, e.g. "login:203.0.113.7".
model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

/// Hands out invoice numbers. Reading the highest existing number and then
/// inserting is not atomic, and the collision lands after the card has already
/// been charged; incrementing a row under a lock cannot collide at all.
model InvoiceCounter {
  /// Numbers restart each year, e.g. "GH-2026".
  prefix String @id
  /// Last number handed out.
  next   Int    @default(0)
}

/// History of the scheduled jobs.
///
/// Failures used to reach `console.error` and nowhere else, so in production
/// nobody would know that a renewal had not been billed, or that the scheduler
/// had stopped calling at all. This is what makes both visible.
model CronRun {
  id         String    @id @default(cuid())
  /// "billing-cycle" or "due-tasks".
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Null while running; false when it threw.
  ok         Boolean?
  /// JSON report the job returned, or the error message when it failed.
  detail     String?   @db.Text
  durationMs Int?

  @@index([job, startedAt])
  @@index([startedAt])
}

/// Keeps two schedulers (or two instances) from running the same job at once.
/// A lease rather than a database lock, so it survives a connection pool and a
/// crashed run: the row expires instead of blocking the job forever.
model JobLock {
  name       String   @id
  /// Random per acquisition, so only the run that took the lock can release it.
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Who changed what in the admin area.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  /// JSON details of the change.
  meta       String?  @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalog: games, regions, pricing
// ---------------------------------------------------------------------------

model Game {
  id                String  @id @default(cuid())
  slug              String  @unique
  name              String
  /// Short tagline shown on cards.
  tagline           String
  /// Longer description shown on the game detail page.
  description       String  @db.Text
  /// Path under /public (e.g. /games/minecraft.svg) or an absolute URL.
  image             String
  /// Accent colour used for gradients on cards (hex).
  accentColor       String  @default("#7c3aed")
  minRamGb          Int
  recommendedRamGb  Int
  minCpu            Int     @default(1)
  minStorageGb      Int     @default(10)
  /// JSON-encoded string[] of supported versions.
  versions          String  @default("[]") @db.VarChar(1024)
  available         Boolean @default(true)
  /// Free text, or the i18n key "coming_soon".
  unavailableReason String? @db.Text
  sortOrder         Int     @default(0)

  /// Pterodactyl provisioning. Without nest + egg the game cannot run on a real node.
  pterodactylNestId Int?
  pterodactylEggId  Int?
  /// Overrides the egg's Docker image; null picks a Java image matching the version.
  dockerImage       String?
  /// Egg variable that receives the chosen version (e.g. MINECRAFT_VERSION).
  versionVariable   String?
  /// JSON object of fixed egg variables, e.g. {"SERVER_JARFILE":"server.jar"}.
  /// No database default on purpose: MySQL 8 rejects a literal DEFAULT on TEXT,
  /// and every write site already supplies a value (zod defaults it to "{}").
  eggVariables      String  @db.Text

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  servers Server[]
}

model Region {
  id              String  @id @default(cuid())
  code            String  @unique
  name            String
  country         String
  /// Emoji flag, e.g. 🇷🇴
  flag            String
  /// Multiplies the monthly price (1.0 = base).
  priceMultiplier Float   @default(1.0)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)
  /// Pterodactyl location servers in this region are deployed to.
  pterodactylLocationId Int?

  servers Server[]
}

/// Prices are stored as integer cents to avoid floating point money.
model PricingConfig {
  id                    String   @id @default(cuid())
  name                  String   @default("default")
  active                Boolean  @default(true)
  currency              String   @default("EUR")
  basePriceCents        Int
  pricePerGbRamCents    Int
  pricePerVcpuCents     Int
  pricePerGbStorageCents Int
  /// 0.05 = 5 % off when paying quarterly
  quarterlyDiscount     Float    @default(0.05)
  /// 0.15 = 15 % off when paying yearly
  yearlyDiscount        Float    @default(0.15)
  updatedAt             DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Servers
// ---------------------------------------------------------------------------

model Server {
  id              String       @id @default(cuid())
  name            String
  ownerId         String
  gameId          String
  regionId        String
  ramGb           Int
  vcpu            Int
  storageGb       Int
  gameVersion     String?
  status          ServerStatus @default(PENDING)
  /// Used by the mock provider to compute lazy state transitions.
  statusChangedAt DateTime     @default(now())
  /// Set only while status is SUSPENDED.
  suspensionReason SuspensionReason?
  /// Identifier on the provisioning backend (mock id / Pterodactyl uuid).
  providerId      String?      @unique
  /// Pterodactyl short identifier (Client API).
  providerIdentifier String?
  /// Pterodactyl numeric id (Application API).
  providerInternalId Int?
  /// Last provisioning error, shown to admins.
  lastError       String?      @db.Text
  ip              String?
  port            Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game         Game          @relation(fields: [gameId], references: [id])
  region       Region        @relation(fields: [regionId], references: [id])
  subscription Subscription?
  orders       Order[]
  backups      Backup[]
  events       ServerEvent[]
  files        ServerFile[]
  consoleEntries ConsoleEntry[]
  tasks        ScheduledTask[]
  addons       ServerAddon[]
  tickets      Ticket[]

  @@index([ownerId])
}

/// State of the *mock* provider: a virtual filesystem per server. A real
/// backend (Pterodactyl) reads and writes files on the node and never touches
/// this table.
model ServerFile {
  id          String   @id @default(cuid())
  serverId    String
  /// Relative, normalised, forward slashes: "plugins/Essentials/config.yml".
  path        String
  isDirectory Boolean  @default(false)
  /// Archives, jars and world data can be listed and deleted but not edited.
  isBinary    Boolean  @default(false)
  content     String?  @db.Text
  sizeBytes   Int      @default(0)
  updatedAt   DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, path])
}

/// State of the *mock* provider: commands sent to a server and its answers.
model ConsoleEntry {
  id        String           @id @default(cuid())
  serverId  String
  kind      ConsoleEntryKind
  level     String           @default("info")
  text      String           @db.Text
  createdAt DateTime         @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

model ScheduledTask {
  id            String        @id @default(cuid())
  serverId      String
  name          String
  action        TaskAction
  /// Console command for COMMAND tasks.
  payload       String?       @db.Text
  frequency     TaskFrequency
  /// HOURLY: run every N hours.
  everyHours    Int           @default(1)
  /// DAILY / WEEKLY: minutes after midnight, UTC (the UI converts from local time).
  minuteOfDayUtc Int          @default(0)
  /// WEEKLY: 0 = Sunday … 6 = Saturday, UTC.
  dayOfWeekUtc  Int           @default(0)
  enabled       Boolean       @default(true)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  /// "ok", "skipped: …" or "failed: …"
  lastStatus    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
  @@index([serverId])
}

/// Catalogue of plugins, mods and modpacks that can be installed with one click.
model Addon {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @db.Text
  kind        AddonKind
  /// JSON-encoded string[] of game slugs this add-on works with.
  gameSlugs   String    @db.VarChar(512)
  version     String
  author      String
  sizeKb      Int
  /// Folder inside the server it is installed into, e.g. "plugins".
  installDir  String
  fileName    String
  createdAt   DateTime  @default(now())

  installs ServerAddon[]
}

model ServerAddon {
  id          String   @id @default(cuid())
  serverId    String
  addonId     String
  installedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  addon  Addon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([serverId, addonId])
}

/// Simulated (Phase 1) or real (Phase 2) server backups.
model Backup {
  id                String       @id @default(cuid())
  serverId          String
  name              String
  sizeMb            Int          @default(0)
  status            BackupStatus @default(CREATING)
  /// Identifier on the provisioning backend.
  providerBackupId  String?
  statusChangedAt   DateTime     @default(now())
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

/// Activity log shown on the server page.
model ServerEvent {
  id        String          @id @default(cuid())
  serverId  String
  type      ServerEventType
  message   String?         @db.Text
  /// JSON payload with extra details (e.g. old/new resources).
  meta      String?         @db.Text
  createdAt DateTime        @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

// ---------------------------------------------------------------------------
// Support: tickets and live chat share one model
// ---------------------------------------------------------------------------

enum TicketKind {
  TICKET
  CHAT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
}

enum TicketCategory {
  GENERAL
  TECHNICAL
  BILLING
  ABUSE
}

model Ticket {
  id            String         @id @default(cuid())
  kind          TicketKind     @default(TICKET)
  subject       String
  category      TicketCategory @default(GENERAL)
  priority      TicketPriority @default(NORMAL)
  status        TicketStatus   @default(OPEN)
  userId        String
  assigneeId    String?
  serverId      String?
  /// True when the last public message came from the customer.
  awaitingStaff Boolean        @default(true)
  lastMessageAt DateTime       @default(now())
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User            @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)
  assignee User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  server   Server?         @relation(fields: [serverId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([userId])
  @@index([assigneeId])
  @@index([serverId])
  @@index([awaitingStaff, lastMessageAt])
  @@index([kind, status])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String   @db.Text
  /// Written by an admin acting as staff (fixed at write time).
  isStaff    Boolean  @default(false)
  /// Staff-only note, never shown to the customer.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

/// A server is built within moments of payment, so the 14-day right of
/// withdrawal only ends if the customer expressly asked for the service to
/// start immediately and acknowledged the consequence (OUG 34/2014, art. 16).
/// Recorded per order, because that is the transaction it applies to.
model Order {
  /// When the customer ticked the immediate-start request, if they did.
  withdrawalWaivedAt DateTime?
  id             String        @id @default(cuid())
  userId         String
  serverId       String?
  kind           OrderKind     @default(NEW)
  status         OrderStatus   @default(PENDING)
  billingPeriod  BillingPeriod
  /// JSON snapshot of the configuration at order time.
  configSnapshot String        @db.Text
  subtotalCents  Int
  /// Billing-period discount (quarterly / yearly).
  discountCents  Int
  /// Discount from a coupon; first order only, never applied to renewals.
  couponDiscountCents Int      @default(0)
  /// Downgrade credit consumed by this order (renewals only).
  creditAppliedCents  Int      @default(0)
  /// subtotal - discount - couponDiscount - creditApplied
  totalCents     Int
  currency       String        @default("EUR")
  /// "mock" | "stripe"; null for orders that needed no payment.
  paymentProvider  String?
  /// Gateway id of the payment (Checkout Session or PaymentIntent).
  paymentReference String?     @unique
  couponId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  server       Server?           @relation(fields: [serverId], references: [id], onDelete: SetNull)
  coupon       Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  subscription Subscription?
  redemption   CouponRedemption?

  @@index([userId])
  @@index([serverId, kind, status])
}

model Coupon {
  id             String     @id @default(cuid())
  /// Stored upper-case; lookups are case-insensitive.
  code           String     @unique
  kind           CouponKind
  /// Percentage (1-100) or cents, depending on `kind`.
  value          Int
  /// null = unlimited
  maxRedemptions Int?
  timesRedeemed  Int        @default(0)
  perUserLimit   Int        @default(1)
  /// Order total (after the period discount) required to use the coupon.
  minOrderCents  Int        @default(0)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  userId      String
  orderId     String   @unique
  amountCents Int
  createdAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  serverId           String             @unique
  orderId            String             @unique
  status             SubscriptionStatus @default(ACTIVE)
  billingPeriod      BillingPeriod
  amountCents        Int
  /// Credit accumulated from downgrades, applied at the next renewal.
  creditCents        Int                @default(0)
  currency           String             @default("EUR")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  /// Period end the "your card will be charged" warning was last sent for.
  /// Compared against currentPeriodEnd so an hourly scheduler sends it once,
  /// not once per hour of the warning window.
  renewalNoticeFor   DateTime?
  /// When the first renewal charge failed; drives suspension and deletion.
  pastDueSince       DateTime?
  lastChargeAttemptAt DateTime?
  chargeAttempts     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

model Invoice {
  id          String        @id @default(cuid())
  /// Human readable number, e.g. GH-2026-000123
  number      String        @unique
  userId      String
  orderId     String
  status      InvoiceStatus @default(OPEN)
  amountCents Int
  currency    String        @default("EUR")
  issuedAt    DateTime      @default(now())
  dueAt       DateTime
  paidAt      DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId])
}

# --- Database ---------------------------------------------------------------
# Local development uses SQLite (zero setup). The file is created automatically.
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL (start locally with `docker compose up -d`)
# DATABASE_URL="postgresql://gigahost:gigahost@localhost:5432/gigahost?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional OAuth providers (buttons appear only when both values are set)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# --- Provisioning -------------------------------------------------------------
# mock         -> simulated servers (Phase 1)
# pterodactyl  -> real servers through Pterodactyl Panel (Phase 2, not implemented yet)
SERVER_PROVIDER="mock"
# PTERODACTYL_URL=""
# PTERODACTYL_API_KEY=""

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GigaHost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

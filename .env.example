# --- Database ---------------------------------------------------------------
# MySQL / MariaDB. With XAMPP the root account has no password by default.
# Create the databases once:
#   CREATE DATABASE gigahost      CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE DATABASE gigahost_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root@localhost:3306/gigahost"
# Options the connection pool reads from the URL's query string:
#   ?sslaccept=strict          verify the server certificate. Use this for any
#                              managed database: without it the password and
#                              every row cross the network in the clear.
#   ?sslaccept=accept_invalid_certs   encrypt without verifying (self-signed)
#   ?connection_limit=5        pool size per instance
#   ?connect_timeout=10000     ms before giving up on a new connection
#   ?pool_timeout=10000        ms to wait for a free connection
#   ?idle_timeout=60           seconds before an idle connection is recycled
# Example: mysql://user:pass@db.example.com:3306/gigahost?sslaccept=strict&connection_limit=10
# Separate database used by `npm run test:integration` (wiped on every run).
TEST_DATABASE_URL="mysql://root@localhost:3306/gigahost_test"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional OAuth providers (buttons appear only when both values are set)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# --- Provisioning -------------------------------------------------------------
# mock         -> simulated servers (no infrastructure needed)
# pterodactyl  -> real servers through a Pterodactyl Panel (see infra/pterodactyl/README.md)
SERVER_PROVIDER="mock"
# PTERODACTYL_URL="http://host.docker.internal:8081"
# PTERODACTYL_APP_KEY="ptla_..."      # Admin -> Application API
# PTERODACTYL_CLIENT_KEY="ptlc_..."   # Account -> API Credentials (same admin user)
# PTERODACTYL_OWNER_USER_ID="1"       # panel user that owns every GigaHost server

# --- Email --------------------------------------------------------------------
# Without SMTP_URL every email is kept in the outbox only (Admin -> Emails),
# which is what you want in development: open one there and follow its link.
# SMTP_URL="smtp://user:password@smtp.example.com:587"
# MAIL_FROM="GigaHost <no-reply@example.com>"
# Accounts must confirm their address before they can order. Set to "false" to
# switch that off.
REQUIRE_EMAIL_VERIFICATION="true"

# --- Payments -----------------------------------------------------------------
# mock    -> every payment succeeds instantly, nothing is charged (default)
# stripe  -> real card payments through Stripe
PAYMENT_PROVIDER="mock"
# Test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the webhook endpoint (<your domain>/api/webhooks/stripe).
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# prints one. Events needed: checkout.session.completed, .expired,
# .async_payment_succeeded, .async_payment_failed
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Scheduler ----------------------------------------------------------------
# Protects /api/cron/*. The scheduler must send "Authorization: Bearer <value>"
# (Vercel Cron does this automatically). Endpoints stay closed while unset.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GigaHost"
# Inlined at BUILD time, not read at runtime: set it before `next build` or
# emails, the sitemap and gateway redirects will point at localhost.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Reverse proxy --------------------------------------------------------------
# Number of proxies between the internet and this app, used to find the real
# client address for rate limiting. X-Forwarded-For is appended to by each hop,
# so entries the client made up sit on the left; the app counts in from the
# right and skips them.
#   0 (default) app is exposed directly - the header is ignored entirely
#   1           one proxy, e.g. Caddy/nginx or Cloudflare
#   2           Cloudflare in front of your own nginx
# Set it too high and clients share one bucket; too low and they can forge one.
TRUSTED_PROXY_HOPS="0"

# --- Who is selling -------------------------------------------------------------
# Romanian law requires an online shop to identify its operator, and to link to
# ANPC and the EU ODR platform. The footer block and the legal pages stay hidden
# until all five required values are set — an invented registration number would
# be worse than none.
# COMPANY_LEGAL_NAME="Example SRL"
# COMPANY_CUI="12345678"
# COMPANY_TRADE_REGISTER="J40/1234/2026"
# COMPANY_ADDRESS="Str. Exemplu 1, București, România"
# COMPANY_EMAIL="contact@example.com"
# Optional:
# COMPANY_PHONE="+40 700 000 000"
# COMPANY_VAT_NUMBER="RO12345678"     # only once VAT-registered

# The terms, privacy, cookie and withdrawal pages were drafted from how the code
# actually behaves. That makes them accurate, not authoritative. Every legal page
# shows a "not yet reviewed by a lawyer" notice until this is set.
# LEGAL_REVIEWED="true"

# --- Seeding ------------------------------------------------------------------
# `npm run db:seed` loads the catalog and creates an admin. In development that
# admin is the published admin@gigahost.local / admin1234; with NODE_ENV=production
# the seed refuses to run unless both of these are set (password: 12+ characters).
# SEED_ADMIN_EMAIL="you@yourdomain.com"
# SEED_ADMIN_PASSWORD=""

# --- Production start-up checks -----------------------------------------------
# With NODE_ENV=production the server refuses to start when a setting above
# would silently lose money or leak accounts: a placeholder AUTH_SECRET, an
# APP_URL still on localhost, a missing SMTP_URL or CRON_SECRET, or either
# provider left on "mock". Run the app once and it lists exactly what is wrong.
#
# Shipping a mock provider on purpose (a free or internal instance) needs the
# matching opt-out, so it is a decision rather than an accident:
# ALLOW_MOCK_PAYMENTS="true"        # every order is marked paid, nothing charged
# ALLOW_MOCK_PROVISIONING="true"    # servers are simulated, no real infrastructure
#
# Skips the checks entirely. Only for a task that does not serve traffic, such
# as a container that runs `prisma migrate deploy` and exits.
# SKIP_ENV_VALIDATION="true"

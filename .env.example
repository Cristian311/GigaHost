# --- Database ---------------------------------------------------------------
# Local development uses SQLite (zero setup). The file is created automatically.
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL (start locally with `docker compose up -d`)
# DATABASE_URL="postgresql://gigahost:gigahost@localhost:5432/gigahost?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional OAuth providers (buttons appear only when both values are set)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_DISCORD_ID=""
# AUTH_DISCORD_SECRET=""

# --- Provisioning -------------------------------------------------------------
# mock         -> simulated servers (no infrastructure needed)
# pterodactyl  -> real servers through a Pterodactyl Panel (see infra/pterodactyl/README.md)
SERVER_PROVIDER="mock"
# PTERODACTYL_URL="http://host.docker.internal:8081"
# PTERODACTYL_APP_KEY="ptla_..."      # Admin -> Application API
# PTERODACTYL_CLIENT_KEY="ptlc_..."   # Account -> API Credentials (same admin user)
# PTERODACTYL_OWNER_USER_ID="1"       # panel user that owns every GigaHost server

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GigaHost"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
